# Multi-Cloud Explorer - Environment Variables
# Copy this file to .env and fill in your values

# Azure App Registration: https://portal.azure.com -> App Registrations
VITE_CLIENT_ID=your-azure-app-client-id-here

# Google Cloud Console: https://console.cloud.google.com -> APIs & Services -> Credentials
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here

# Optional (recommended for automatic Google Drive reconnection via refresh tokens):
# Server-only secret — NOT prefixed with VITE_ so it is never bundled into browser JS.
# Used by /api/google-auth locally (Vite middleware) and on Vercel (Serverless Function).
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
